# 云端 AI 远程运维助手 — 环境配置模板
# 复制为 .env 并填写真实值：cp .env.example .env

# OpenAI 兼容 API 配置（DeepSeek 或任意兼容端点）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=deepseek-chat

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============================================================
# Hermes 通道（可选，默认不启用）
# 不配置以下项 = 纯 DeepSeek 大脑，行为等同旧版。
# 配置后：前端/AGENT_BRAIN 可切换到 Hermes 自治 agent（需本机部署 Hermes gateway 且开启 api_server）。
# ============================================================
# 本机 Hermes api_server 地址（OpenAI 兼容端点）
# HERMES_BASE_URL=http://127.0.0.1:8642/v1
# HERMES_API_KEY=your-api-server-key
# HERMES_MODEL=hermes-agent
# 默认大脑：deepseek | hermes（也可在页面顶部下拉按消息切换）
# AGENT_BRAIN=deepseek
# HTTP 桥接接口共享密钥（Hermes 用 curl 调 /api/bridge/execute 时校验，必须改）
# BRIDGE_HTTP_SECRET=change-me-to-a-long-random-string

# ============================================================
# 管理后台（可选）
# ============================================================
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# ADMIN_SESSION_TTL=43200
